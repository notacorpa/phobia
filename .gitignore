# 1. Always ignore build artifacts, package folders, and OS junk
/dist/
/release/
/node_modules/
.DS_Store
Thumbs.db
*.log

# 2. Block user content inside the root assets folder, but keep /assets/engine/ tracked
#/assets/*
#!.phobia/assets/

# 3. Block user script files inside src/ while keeping core engine folders and entry points tracked
/src/*
!/src/global.d.ts
!/src/main.ts