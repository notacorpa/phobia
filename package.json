{
  "name": "phobia",
  "version": "1.0.1-alpha.1",
  "buildtype": "debug",
  "description": "Offline Web Game Engine",
  "author": "Aedan Maki",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "package": "node build.mjs --package",
    "cleanup": "node cleanup.mjs"
  },
  "exports": {
    ".": "./src/main.ts",
    "./engine/*": "./.phobia/src/*"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "esbuild": "^0.20.0",
    "javascript-obfuscator": "^5.9.0"
  }
}
