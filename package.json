{
  "name": "phobia",
  "version": "1.0.0",
  "description": "Offline 2D Web Game Engine for Chromebooks",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "package": "node build.mjs --package"
  },
  "exports": {
    ".": "./src/main.ts",
    "./engine/*": "./src/engine/*",
    "./core": "./src/engine/core/index.ts"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "esbuild": "^0.20.0"
  }
}