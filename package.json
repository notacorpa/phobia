{
  "name": "phobia",
  "version": "0.0.1-alpha.1",
  "description": "Offline 2D Web Game Engine for Chromebooks",
  "author": "Aedan Maki",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
